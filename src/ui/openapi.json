            "type": "integer",
            "title": "Missing Photo Grace Period Days",
            "default": 30
          },
          "thumbnail_grid_size_px": {
            "type": "integer",
            "title": "Thumbnail Grid Size Px",
            "default": 256
          },
          "thumbnail_preview_size_px": {
            "type": "integer",
            "title": "Thumbnail Preview Size Px",
            "default": 1024
          }
        },
        "type": "object",
        "title": "AppSettings"
      },
